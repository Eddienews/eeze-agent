# Copy to .env and fill in. Never commit .env.

TYPESAFE_API_KEY=

# Optional overrides (defaults shown)
# TYPESAFE_DEFAULT_MODEL=jev-latest
# PLANNER_PROVIDER=openrouter
# PLANNER_MODEL=
# OPENROUTER_API_KEY=
#
# Planner / spec writer engine: 'http' (default) or 'codex' (the Codex subscription;
# subscription-only, no paid spend). EEZE_SPEC_ENGINE falls back to EEZE_PLANNER_ENGINE.
# EEZE_PLANNER_ENGINE=http
# EEZE_SPEC_ENGINE=
#
# Provider selection for the HTTP brains (P2). The shipped path is BYO keys: a key entered in
# the app lands in ~/.eeze/secrets.json (write-only, never returned by the API) and beats every
# variable below. Provider ids: openrouter | openai | google | xai | groq | ollama | codex.
# EEZE_PROVIDER=openrouter
# NOTE: the EEZE_<ROLE>_* variables are read by API-key providers ONLY. The Codex subscription
# reads EEZE_CODEX_*; a local server (ollama) reads neither (use the store / PUT /providers/{id}).
#
# Codex-subscription brain (EEZE_BRAIN=codex) — local-only, subscription-only by default
# EEZE_CODEX_MODEL_ROUTINE=gpt-6-luna   # routine tier (free rules floor)
# EEZE_CODEX_MODEL_HARD=gpt-6-sol       # hard tier / failed-run escalation target
# EEZE_CODEX_MODEL=                     # absolute pin for BOTH tiers (empty = per tier)
# EEZE_CODEX_ATTEMPTS=2                 # CLI retries inside the subscription before degrading
# EEZE_CODEX_FALLBACK=none              # 'openrouter' opts into the PAID fallback (default: no spend)
# EEZE_CODEX_ROUTER=rules               # free deterministic tier choice; 'off' forces routine
# EEZE_CODEX_BIN=codex
# EEZE_CODEX_TIMEOUT=180

# --- Guard rails (all optional) ---
# Daily cap in USD for paid model calls, per agent (0 = no cap; an agent's own
# budget_usd_daily in agents.yaml wins). Default 2.
# EEZE_BUDGET_USD_DAILY=2
# Pending approvals expire after this many hours so a forgotten gate never freezes a
# routine (0 = never). Default 72.
# EEZE_APPROVAL_TTL_HOURS=72
# Second reminder toast for an approval nobody decided, after this many hours. Default 4.
# EEZE_APPROVAL_REMIND_HOURS=4
# How many days a signed-in browser stays signed in (1-365). `eeze unpair` signs all out.
# EEZE_SESSION_DAYS=30
# Developer only: allow the Vite dev server origins and FastAPI /docs.
# EEZE_DEV_ORIGINS=1
